<%@ page pageEncoding="UTF-8" %>
<footer class="mh-admin-footer"><span>MovieHub</span><a href="<c:out value='${publicHomeUrl}' />">Khám phá phim</a></footer>
<dialog class="mh-admin-dialog" id="admin-confirm" aria-labelledby="confirm-title" aria-describedby="confirm-description">
    <h2 id="confirm-title">Xác nhận thay đổi</h2>
    <p id="confirm-description"></p>
    <div class="mh-admin-actions"><button class="mh-admin-button" type="button" data-confirm-cancel>Hủy</button><button class="mh-admin-button mh-admin-button-primary" type="button" data-confirm-accept>Xác nhận</button></div>
</dialog>
