<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:url var="adminHomeUrl" value="/admin/dashboard" />
<c:url var="adminMoviesUrl" value="/admin/movies" />
<c:url var="adminCategoriesUrl" value="/admin/categories" />
<c:url var="adminUsersUrl" value="/admin/users" />
<c:url var="adminModerationUrl" value="/admin/moderation" />
<c:url var="publicHomeUrl" value="/" />
<a class="mh-admin-skip" href="#admin-main">Đến nội dung</a>

<div class="mh-admin-layout">
    <!-- Dedicated Admin Studio Sidebar -->
    <aside class="mh-admin-sidebar" id="admin-sidebar" aria-label="Bảng điều hướng quản trị">
        <div class="mh-sidebar-header">
            <a class="mh-sidebar-brand" href="<c:out value='${adminHomeUrl}' />">
                <span class="mh-brand-icon-box">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="mh-brand-icon" aria-hidden="true">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                </span>
                <span class="mh-brand-text">
                    <span class="mh-brand-title">Movie<span>Hub</span></span>
                    <span class="mh-brand-badge">STUDIO</span>
                </span>
            </a>
            <button type="button" class="mh-sidebar-close" id="sidebar-close" aria-label="Đóng thanh điều hướng">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <div class="mh-sidebar-profile">
            <div class="mh-admin-avatar">
                <c:choose>
                    <c:when test="${not empty sessionScope.authUser.fullName}">
                        <c:out value="${fn:substring(sessionScope.authUser.fullName, 0, 1)}" />
                    </c:when>
                    <c:otherwise>A</c:otherwise>
                </c:choose>
            </div>
            <div class="mh-admin-user-meta">
                <span class="mh-admin-user-name">
                    <c:out value="${sessionScope.authUser.fullName != null ? sessionScope.authUser.fullName : 'Quản trị viên'}" />
                </span>
                <span class="mh-admin-user-role">Quản trị Studio</span>
            </div>
        </div>

        <div class="mh-sidebar-nav-wrap">
            <div class="mh-sidebar-section-title">QUẢN TRỊ HỆ THỐNG</div>
            <nav id="admin-navigation" class="mh-sidebar-nav" aria-label="Điều hướng quản trị">
                <a class="mh-nav-item ${adminSection == 'dashboard' ? 'is-active' : ''}" href="<c:out value='${adminHomeUrl}' />" <c:if test="${adminSection == 'dashboard'}">aria-current="page"</c:if>>
                    <span class="mh-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                    </span>
                    <span class="mh-nav-text">Tổng quan &amp; Phân tích</span>
                </a>

                <a class="mh-nav-item ${adminSection == 'movies' ? 'is-active' : ''}" href="<c:out value='${adminMoviesUrl}' />" <c:if test="${adminSection == 'movies'}">aria-current="page"</c:if>>
                    <span class="mh-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                            <line x1="7" y1="2" x2="7" y2="22"></line>
                            <line x1="17" y1="2" x2="17" y2="22"></line>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <line x1="2" y1="7" x2="7" y2="7"></line>
                            <line x1="2" y1="17" x2="7" y2="17"></line>
                            <line x1="17" y1="17" x2="22" y2="17"></line>
                            <line x1="17" y1="7" x2="22" y2="7"></line>
                        </svg>
                    </span>
                    <span class="mh-nav-text">Kho phim</span>
                </a>

                <a class="mh-nav-item ${adminSection == 'categories' ? 'is-active' : ''}" href="<c:out value='${adminCategoriesUrl}' />" <c:if test="${adminSection == 'categories'}">aria-current="page"</c:if>>
                    <span class="mh-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                            <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                    </span>
                    <span class="mh-nav-text">Thể loại phim</span>
                </a>

                <a class="mh-nav-item ${adminSection == 'moderation' ? 'is-active' : ''}" href="<c:out value='${adminModerationUrl}' />" <c:if test="${adminSection == 'moderation'}">aria-current="page"</c:if>>
                    <span class="mh-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 11 12 14 22 4"></polyline>
                        </svg>
                    </span>
                    <span class="mh-nav-text">Duyệt nội dung</span>
                    <c:if test="${not empty dashboard.totalPending && dashboard.totalPending > 0}">
                        <span class="mh-nav-counter"><c:out value="${dashboard.totalPending}" /></span>
                    </c:if>
                </a>

                <a class="mh-nav-item ${adminSection == 'users' ? 'is-active' : ''}" href="<c:out value='${adminUsersUrl}' />" <c:if test="${adminSection == 'users'}">aria-current="page"</c:if>>
                    <span class="mh-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                    <span class="mh-nav-text">Người dùng</span>
                </a>
            </nav>
        </div>

        <div class="mh-sidebar-footer">
            <a class="mh-sidebar-exit" href="<c:out value='${publicHomeUrl}' />">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Về trang xem phim</span>
            </a>
        </div>
    </aside>

    <!-- Mobile Drawer Backdrop -->
    <div class="mh-sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <!-- Main Content Wrapper -->
    <div class="mh-admin-main-wrap">
        <!-- Modern Studio Topbar -->
        <header class="mh-admin-topbar">
            <div class="mh-topbar-left">
                <button type="button" class="mh-topbar-toggle" id="sidebar-toggle" aria-label="Mở thanh điều hướng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="mh-topbar-breadcrumb">
                    <span class="mh-crumb-parent">Studio</span>
                    <span class="mh-crumb-sep">/</span>
                    <span class="mh-crumb-active">
                        <c:choose>
                            <c:when test="${adminSection == 'dashboard'}">Tổng quan &amp; Phân tích</c:when>
                            <c:when test="${adminSection == 'movies'}">Kho phim</c:when>
                            <c:when test="${adminSection == 'categories'}">Thể loại phim</c:when>
                            <c:when test="${adminSection == 'moderation'}">Duyệt nội dung</c:when>
                            <c:when test="${adminSection == 'users'}">Người dùng</c:when>
                            <c:otherwise>Quản trị</c:otherwise>
                        </c:choose>
                    </span>
                </div>
            </div>
            <div class="mh-topbar-right">
                <div class="mh-topbar-live-status">
                    <span class="mh-live-dot"></span>
                    <span>Hệ thống trực tuyến</span>
                </div>
                <a class="mh-topbar-site-link" href="<c:out value='${publicHomeUrl}' />">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Xem rạp phim</span>
                </a>
            </div>
        </header>
