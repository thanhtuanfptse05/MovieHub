<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>MovieHub</display-name>

    <!-- Session Configuration: 30 minutes idle timeout, HttpOnly cookies (D-05 / SYS-06) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Filters -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.moviehub.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CSRFFilter</filter-name>
        <filter-class>com.moviehub.filter.CSRFFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CSRFFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.moviehub.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.moviehub.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.moviehub.controller.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.moviehub.controller.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.moviehub.controller.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.moviehub.controller.auth.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>com.moviehub.controller.auth.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.moviehub.controller.user.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.moviehub.controller.movie.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern></url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MovieListServlet</servlet-name>
        <servlet-class>com.moviehub.controller.movie.MovieListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovieListServlet</servlet-name>
        <url-pattern>/movies</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MovieDetailServlet</servlet-name>
        <servlet-class>com.moviehub.controller.movie.MovieDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovieDetailServlet</servlet-name>
        <url-pattern>/movies/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FavoriteListServlet</servlet-name>
        <servlet-class>com.moviehub.controller.favorite.FavoriteListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FavoriteListServlet</servlet-name>
        <url-pattern>/favorites</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FavoriteAddServlet</servlet-name>
        <servlet-class>com.moviehub.controller.favorite.FavoriteAddServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FavoriteAddServlet</servlet-name>
        <url-pattern>/favorites/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FavoriteRemoveServlet</servlet-name>
        <servlet-class>com.moviehub.controller.favorite.FavoriteRemoveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FavoriteRemoveServlet</servlet-name>
        <url-pattern>/favorites/remove</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewSaveServlet</servlet-name>
        <servlet-class>com.moviehub.controller.review.ReviewSaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewSaveServlet</servlet-name>
        <url-pattern>/reviews/save</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewDeleteServlet</servlet-name>
        <servlet-class>com.moviehub.controller.review.ReviewDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewDeleteServlet</servlet-name>
        <url-pattern>/reviews/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QuestionCreateServlet</servlet-name>
        <servlet-class>com.moviehub.controller.qa.QuestionCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuestionCreateServlet</servlet-name>
        <url-pattern>/questions/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnswerCreateServlet</servlet-name>
        <servlet-class>com.moviehub.controller.qa.AnswerCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnswerCreateServlet</servlet-name>
        <url-pattern>/answers/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ErrorServlet</servlet-name>
        <servlet-class>com.moviehub.controller.error.ErrorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ErrorServlet</servlet-name>
        <url-pattern>/403</url-pattern>
        <url-pattern>/404</url-pattern>
        <url-pattern>/500</url-pattern>
    </servlet-mapping>

    <!-- Error Page Mappings -->
    <error-page>
        <error-code>403</error-code>
        <location>/403</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/404</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/500</location>
    </error-page>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
        <taglib>
            <taglib-uri>jakarta.tags.core</taglib-uri>
            <taglib-location>/WEB-INF/tlds/c.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>jakarta.tags.fmt</taglib-uri>
            <taglib-location>/WEB-INF/tlds/fmt.tld</taglib-location>
        </taglib>
        <taglib>
            <taglib-uri>jakarta.tags.functions</taglib-uri>
            <taglib-location>/WEB-INF/tlds/fn.tld</taglib-location>
        </taglib>
    </jsp-config>

</web-app>
